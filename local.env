# ---- Auth (server-only) ----
# The PIN the desk operator enters. Must be EXACTLY 8 digits.
# Change this from the default before deploying.
ADMIN_PIN=12345678

# Random 64-char hex string. Signs session tokens.
# Rotating this logs everyone out immediately.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# ---- Google Sheets ----
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=

# ---- Optional ----
# Admin PIN is NOT read from VITE_ anymore. Never set VITE_ADMIN_PIN.